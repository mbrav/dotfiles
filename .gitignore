# AI
# Project-local Claude state at the repo root — never tracked.
/.claude/

# ~/.claude is symlinked to dotfiles/.claude, so the WHOLE of Claude Code's
# runtime state physically lives in this repo: ~1.2G of conversation
# transcripts, session .key files, telemetry, caches. The repo is public.
#
# This is a WHITELIST on purpose. Enumerating data directories would silently
# leak whatever Claude Code adds in the next release; here anything new is
# ignored by default and must be opted in explicitly below.
!dotfiles/.claude/
dotfiles/.claude/**

# --- the only tracked config ---
!dotfiles/.claude/settings.json
!dotfiles/.claude/statusline-command.sh
!dotfiles/.claude/hooks/
!dotfiles/.claude/hooks/**
!dotfiles/.claude/skills/
!dotfiles/.claude/skills/**

# --- carve back out of skills/ ---
dotfiles/.claude/skills/synced/**
dotfiles/.claude/skills/*.tar.gz

scripts/secrets.ini
dotfiles/.config/scripts/_secrets
dotfiles/.config/fish/fish_variables
dotfiles/.config/k9s/clusters
dotfiles/.config/k9s/*.log
dotfiles/.config/herdr/*.log
dotfiles/.config/herdr/*.sock
dotfiles/.config/herdr/session.json
dotfiles/.config/herdr/release-notes.json
dotfiles/.config/herdr/.plugins.lock
# herdr writes its runtime state into its config dir, and the repo is public.
# session-history.json / session-snapshots are raw terminal scrollback — every
# command, output and anything printed into a pane. Never commit them.
dotfiles/.config/herdr/*.sock.agent
dotfiles/.config/herdr/session-history.json
dotfiles/.config/herdr/session-snapshots/
dotfiles/.config/herdr/plugins/
dotfiles/.config/herdr/plugins.json
dotfiles/.config/nvim/lazy-lock.json
dotfiles/.config/zed/prompts
dotfiles/.config/zed/conversations
__pycache__/
htop_history

# Binary archive, not a skill source tree — git cannot diff it.
dotfiles/.claude/skills/*.tar.gz

# headroom lives in the repo and is symlinked to ~/.config/headroom.
# Layout mirrors upstream: the directory itself is the workspace (read-write
# state) and config/ sits inside it. Ignore everything, then un-ignore the
# hand-written config by name. install_id is a machine identity token; the DB,
# logs, cache and savings telemetry are state and must never be committed.
dotfiles/.config/headroom/**
!dotfiles/.config/headroom/.gitkeep
!dotfiles/.config/headroom/settings.json
!dotfiles/.config/headroom/restart-proxy.sh
!dotfiles/.config/headroom/config/
!dotfiles/.config/headroom/config/**
dotfiles/.config/headroom/config/install_id
