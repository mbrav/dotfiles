{
  "model": "opus",
  "skillOverrides": {
    "anthropic-skills:pdf": "off",
    "anthropic-skills:xlsx": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:docx": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:docs": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/headroom-ensure.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline-command.sh\"",
    "padding": 0
  },
  "enabledPlugins": {
    "cc-plugin-sec-default@builtin": false
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-opus-5": {
      "effortLevel": "high"
    }
  }
}
