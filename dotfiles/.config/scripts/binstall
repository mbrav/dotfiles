#!/usr/bin/env bash
# Install various CLI binaries directly from GitHub releases.
#
# Data-driven: every tool is one row in the BIN_* associative arrays below.
# Adding a new tool = add a row. Requires bash 4+ (associative arrays) — both the
# container bash and the homebrew bash on macOS satisfy this.
#
# Usage: binstall <name|all> [bin_dir] [delay]
#   bin_dir  target install path        (default: /usr/local/bin)
#   delay    curl request delay seconds (default: 0.5)

# Set script_dir to the directory of this script
script_dir="$(dirname "$(realpath "$0")")"

# Set default bin_dir and delay, allow override via script args
bin_dir="${2:-${bin_dir:-/usr/local/bin}}"
delay="${3:-${delay:-0.5}}"

# Source util lib
source "${script_dir}/_util"

ran_col_str "Binary install utility" c

# METADATA TABLE
# Asset/path placeholders: {v}=tag as-is, {V}=tag w/o leading v,
#                          {arch}=$(uname -m), {os}=$(uname -s)
# Defaults when unset: KIND=raw, PATH=<name>, VERPAT=^v#.#.#, FLAGS=''
# FLAGS: space-separated constraints — "linux" and/or "x86".
declare -A BIN_REPO BIN_ASSET BIN_KIND BIN_PATH BIN_VERPAT BIN_FLAGS

BIN_REPO["docker-compose"]=docker/compose
BIN_ASSET["docker-compose"]='docker-compose-{os}-{arch}'

BIN_REPO[k9s]=derailed/k9s
BIN_ASSET[k9s]='k9s_{os}_amd64.tar.gz'
BIN_KIND[k9s]=tgz
BIN_FLAGS[k9s]='x86'

BIN_REPO[eza]=eza-community/eza
BIN_ASSET[eza]='eza_{arch}-unknown-linux-{libc}.tar.gz'
BIN_KIND[eza]=tgz
BIN_FLAGS[eza]='linux'

BIN_REPO[bat]=sharkdp/bat
BIN_ASSET[bat]='bat-{v}-{arch}-unknown-linux-musl.tar.gz'
BIN_KIND[bat]=tgz
BIN_PATH[bat]='bat-{v}-{arch}-unknown-linux-musl/bat'
BIN_FLAGS[bat]='linux'

BIN_REPO[starship]=starship/starship
BIN_ASSET[starship]='starship-{arch}-unknown-linux-musl.tar.gz'
BIN_KIND[starship]=tgz
BIN_FLAGS[starship]='linux'

BIN_REPO[atuin]=atuinsh/atuin
BIN_ASSET[atuin]='atuin-{arch}-unknown-linux-musl.tar.gz'
BIN_KIND[atuin]=tgz
BIN_FLAGS[atuin]='linux'

BIN_REPO[herdr]=herdrdev/herdr
BIN_ASSET[herdr]='herdr-linux-{arch}'
BIN_FLAGS[herdr]='linux'

BIN_REPO[fzf]=junegunn/fzf
BIN_ASSET[fzf]='fzf-{V}-linux_amd64.tar.gz'
BIN_KIND[fzf]=tgz
BIN_FLAGS[fzf]='linux x86'

BIN_REPO[jq]=jqlang/jq
BIN_ASSET[jq]='jq-linux-amd64'
BIN_VERPAT[jq]='^jq-[0-9]+\.[0-9]+$'
BIN_FLAGS[jq]='linux x86'

BIN_REPO[jqp]=noahgorstein/jqp
BIN_ASSET[jqp]='jqp_Linux_x86_64.tar.gz'
BIN_KIND[jqp]=tgz
BIN_FLAGS[jqp]='linux x86'

BIN_REPO[htmlq]=mgdm/htmlq
BIN_ASSET[htmlq]='htmlq-{arch}-linux.tar.gz'
BIN_KIND[htmlq]=tgz
BIN_FLAGS[htmlq]='linux'

BIN_REPO[yq]=mikefarah/yq
BIN_ASSET[yq]='yq_linux_amd64'
BIN_FLAGS[yq]='linux x86'

BIN_REPO[fd]=sharkdp/fd
BIN_ASSET[fd]='fd-{v}-{arch}-unknown-linux-musl.tar.gz'
BIN_KIND[fd]=tgz
BIN_PATH[fd]='fd-{v}-{arch}-unknown-linux-musl/fd'
BIN_FLAGS[fd]='linux'

BIN_REPO[upx]=upx/upx
BIN_ASSET[upx]='upx-{V}-amd64_linux.tar.xz'
BIN_KIND[upx]=txz
BIN_PATH[upx]='upx-{V}-amd64_linux/upx'
BIN_FLAGS[upx]='linux x86'

BIN_REPO[gum]=charmbracelet/gum
BIN_ASSET[gum]='gum_{V}_{os}_{arch}.tar.gz'
BIN_KIND[gum]=tgz

BIN_REPO[bottom]=ClementTsang/bottom
BIN_ASSET[bottom]='bottom_{arch}-unknown-linux-musl.tar.gz'
BIN_KIND[bottom]=tgz
BIN_PATH[bottom]=btm
BIN_VERPAT[bottom]='^[0-9]+\.[0-9]+\.[0-9]+$'
BIN_FLAGS[bottom]='linux x86'

BIN_REPO[btop]=aristocratos/btop
BIN_ASSET[btop]='btop-{arch}-unknown-linux-{libc}.tar.gz'
BIN_KIND[btop]=tgz
BIN_PATH[btop]='btop/bin/btop'
BIN_FLAGS[btop]='linux'

BIN_REPO[oha]=hatoo/oha
BIN_ASSET[oha]='oha-linux-amd64'
BIN_FLAGS[oha]='linux x86'

BIN_REPO[sops]=getsops/sops
BIN_ASSET[sops]='sops-{v}.linux.amd64'
BIN_FLAGS[sops]='linux x86'

BIN_REPO[lazygit]=jesseduffield/lazygit
BIN_ASSET[lazygit]='lazygit_{V}_linux_x86_64.tar.gz'
BIN_KIND[lazygit]=tgz
BIN_FLAGS[lazygit]='linux x86'

# Ordered install list for `all` and help output
binaries=(
  docker-compose k9s eza bat starship atuin herdr fzf jq jqp htmlq yq fd upx gum
  bottom btop oha sops lazygit
)

bin_list="${binaries[*]}"
cmd_arg_help \
  "Program name. Available: ${GREEN}${bin_list}${CLEAR}" \
  "Bin path. Set: ${GREEN}${bin_dir}${CLEAR}" \
  "Curl requests delay in seconds: Set: ${GREEN}${delay}${CLEAR}s"

# Check requirements
command -v jq >/dev/null || error_msg "Please install jq JSON parsing utility" 1

# HELPERS

function bin_install() {
  # Install a file into a directory, using sudo if not writable.
  # $1 - Source file
  # $2 - Target directory (basename of source is preserved)
  if [[ -w "${2}" ]]; then
    info_msg "Directory ${2} is writable"
    install -p -m 755 "${1}" "${2}"
  else
    warning_msg "Sudo must be used for ${2}"
    sudo install -p --owner=root --group=root -m 755 "${1}" "${2}"
  fi
}

function latest_version() {
  # Fetch the latest matching release tag for a repo.
  # $1 - owner/repo
  # $2 - grep -P version pattern (optional; default vX.Y.Z)
  local repo="${1}"
  local pat="${2:-^v[0-9]+\.[0-9]+\.[0-9]+$}"
  sleep "${delay}"
  curl -s "https://api.github.com/repos/${repo}/tags" |
    jq -r 'if type == "array" then .[].name else empty end' |
    grep -P -m 1 "${pat}"
}

function expand_str() {
  # Expand {v}/{V}/{arch}/{os}/{libc} placeholders.
  # {libc} = musl on x86_64, gnu on aarch64 (eza/btop have no musl aarch64 builds).
  # $1 - template string
  # $2 - version tag
  local s="${1}" v="${2}"
  local V="${v##*v}" # strip leading v (or up-to-last v)
  local libc="musl"
  [[ "$(uname -m)" == "aarch64" ]] && libc="gnu"
  s="${s//\{v\}/${v}}"
  s="${s//\{V\}/${V}}"
  s="${s//\{arch\}/$(uname -m)}"
  s="${s//\{os\}/$(uname -s)}"
  s="${s//\{libc\}/${libc}}"
  echo "${s}"
}

function install_one() {
  # Download + install a single tool from its metadata row.
  # $1 - tool name (key in BIN_* arrays)
  local name="${1}"
  local repo="${BIN_REPO[${name}]:-}"
  [[ -n "${repo}" ]] || {
    error_msg "Unknown program: ${CLEAR}${UNDERLINE}${name}"
    error_msg "List of available binaries: ${CLEAR}${UNDERLINE}${bin_list}" 1
  }

  local kind="${BIN_KIND[${name}]:-raw}"
  local flags="${BIN_FLAGS[${name}]:-}"

  # Platform constraint guards
  if [[ " ${flags} " == *" linux "* ]]; then
    [[ -n $(is_linux) ]] || error_msg "Can only download Linux binary. Your OS: $(uname -s)" 1
  fi
  if [[ " ${flags} " == *" x86 "* ]]; then
    [[ -n $(is_x86) ]] || error_msg "Can only download x86 binary. Your arch: $(uname -m)" 1
  fi

  info_msg "Fetching latest ${name} tag from GitHub"
  local version
  version=$(latest_version "${repo}" "${BIN_VERPAT[${name}]:-}")
  [[ -n "${version}" ]] || error_msg "Error fetching version" 1
  info_msg "Setting version to: ${UNDERLINE}${version}"

  local asset url
  asset=$(expand_str "${BIN_ASSET[${name}]}" "${version}")
  url="https://github.com/${repo}/releases/download/${version}/${asset}"
  sleep "${delay}"
  [[ $(check_url "${url}") -ne 0 ]] && error_msg "Bad url: ${url}" 6
  success_msg "Valid url: ${UNDERLINE}${url}"

  if [[ "${kind}" == "raw" ]]; then
    # Raw binary: download straight to name and install
    local dst="/tmp/${name}"
    curl -L "${url}" -o "${dst}"
    chmod +x "${dst}"
    bin_install "${dst}" "${bin_dir}/"
    rm -f "${dst}"
  else
    # Archive: download, unpack, install from inner path
    local topt="z"
    [[ "${kind}" == "txz" ]] && topt="J"
    local down="/tmp/${asset}"
    local dir="/tmp/${name}-${version}"
    local inner
    inner=$(expand_str "${BIN_PATH[${name}]:-${name}}" "${version}")
    mkdir -pv "${dir}"
    curl -L "${url}" -o "${down}"
    tar -x"${topt}"f "${down}" -C "${dir}"
    bin_install "${dir}/${inner}" "${bin_dir}/"
    rm -rf "${down}" "${dir}"
  fi

  success_msg "${name} installed"
}

case "${1:-}" in
"" | -h | --help)
  error_msg "Please provide a program name or 'all'. Available: ${CLEAR}${UNDERLINE}${bin_list}" 1
  ;;
all)
  warning_msg "Installing all binaries: ${bin_list}"
  for b in "${binaries[@]}"; do
    install_one "${b}"
  done
  ;;
*)
  install_one "${1}"
  ;;
esac
