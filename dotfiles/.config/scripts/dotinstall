#!/usr/bin/env bash

set -euo pipefail

script_id="mbrav/dotfiles installer"
force="${force:-}"
script_dir="$(dirname "$(realpath "$0")")"
dot_dir="$(realpath "${script_dir}/../../../")"

# Source util functions
source "${script_dir}/_util"

# Remove $1 so a symlink can take its place. A real directory is moved to
# $1.bak instead: ~/.claude holds credentials and history that rm -rf would lose
function clear_target() {
  local target="$1" bak="$1.bak"
  if [[ -d "$target" && ! -L "$target" ]]; then
    # mv into an existing dir would nest inside it, so never reuse a .bak
    [[ -e "$bak" || -L "$bak" ]] && bak="$bak-$(date +%Y%m%d%H%M%S)"
    mv -v "$target" "$bak"
  else
    rm -fv "$target"
  fi
}

# Symlink $1 (repo item) to $2 (target in $HOME)
function link_item() {
  local item_path="$1" target="$2"

  # Already linked from an earlier run, nothing to replace
  [[ -L "$target" && "$(readlink "$target")" == "$item_path" ]] && return 0

  # -L as well: a dangling symlink fails -e but still blocks ln
  if [[ (-e "$target" || -L "$target") && -z "$force" ]]; then
    info_msg "Item $target exists"
    # if, not &&: answering "n" to the last item would otherwise become the
    # function's exit status and report the whole install as failed
    if yes_no_prompt "${GREEN}Replace $target with new symlink?${YELLOW}"; then
      clear_target "$target" && ln -sv "$item_path" "$target"
    fi
  else
    info_msg "Symlinking file $item_path to $target"
    clear_target "$target"
    ln -sv "$item_path" "$target"
  fi
}

function dotfiles_symlink() {
  # Globs instead of parsing ls; dotglob for hidden entries, nullglob so an
  # empty dir loops zero times instead of over the literal pattern
  shopt -s dotglob nullglob
  local item_path

  # Every entry in .config, folders included
  mkdir -p "$HOME/.config"
  for item_path in "$dot_dir/dotfiles/.config/"*; do
    link_item "$item_path" "$HOME/.config/${item_path##*/}"
  done

  # Everything else at the top level, folders like .claude included. .config
  # itself stays a real dir, its entries are linked above
  for item_path in "$dot_dir/dotfiles/"*; do
    [[ "${item_path##*/}" == .config ]] && continue
    link_item "$item_path" "$HOME/${item_path##*/}"
  done
}

ran_col_str "${script_id} installer"
# $? after an if-block is the block's status, which is always 0 — capture the
# function's own exit status instead, or the failure branch can never fire.
rc=0
if [[ -z "$force" ]]; then
  warning_msg "Script in interative mode. Use force=1 ./install.sh for non-interactive install"
  yes_no_prompt "${GREEN}Install Dotfiles as symlinks? ${YELLOW}" &&
    { dotfiles_symlink || rc=$?; }
else
  info_msg "Installing dotfiles non-interactively"
  dotfiles_symlink || rc=$?
fi

[[ $rc -ne 0 ]] && error_msg "Failed to install dotfiles" 1
success_msg "Dotfiles install successfuly! Reload shell."

exit 0
