#!/usr/bin/env bash
# ovisup -- update the ovis (herdr web UI) checkout to the newest release tag.
# Run by ovis.service as ExecStartPre; a no-op when already current, and any
# failure (offline, build error) is non-fatal so the old build keeps serving.
set -euo pipefail

app="${OVIS_APP_DIR:-$HOME/.local/share/ovis/app}"
export PATH="$HOME/.bun/bin:$PATH"

[[ -d "$app/.git" ]] || { echo "ovisup: $app is not a git checkout" >&2; exit 1; }
cd "$app"

current=$(git describe --tags --exact-match 2>/dev/null || echo none)
latest=$(timeout 15 git ls-remote --tags --refs origin 'v*' | awk -F/ '{print $NF}' | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | sort -V | tail -n1)
[[ -n "$latest" ]] || { echo "ovisup: could not list remote tags, keeping $current" >&2; exit 1; }

if [[ "$current" == "$latest" ]]; then
    echo "ovisup: already at $latest"
    exit 0
fi

echo "ovisup: $current -> $latest"
git fetch --depth 1 origin tag "$latest"
git checkout --quiet "$latest"
bun install --frozen-lockfile
bun run build
echo "ovisup: updated to $latest"
